# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local development uses the private database started by `npm run db`.
# In production, use the MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/franchise_portal?replicaSet=rs0

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Address the browser uses to open the portal. Used in links inside emails.
CLIENT_ORIGIN=http://localhost:5173

# Production only (docs/GO-LIVE.md): serve the built website from this server, and the number of
# proxies / load balancers in front of it.
CLIENT_DIST_DIR=
TRUST_PROXY=1

# Email delivery. `dev_outbox` (development only) keeps emails in the test mailbox page.
# `smtp` sends through any provider's SMTP service (Amazon SES, SendGrid, Brevo, Zoho, ...).
EMAIL_PROVIDER=dev_outbox
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS). Email is never sent unencrypted.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to recipients; its domain must be verified with the provider (SPF, DKIM, DMARC).
EMAIL_FROM=
EMAIL_REPLY_TO=
# Gmail alternative (same effect as the SMTP_* lines above): EMAIL_PROVIDER=gmail and
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_SECURE=false (STARTTLS)
#   EMAIL_USER=<gmail address>
#   EMAIL_PASSWORD=<Google App Password: Google Account > Security > 2-Step Verification > App passwords>
#   EMAIL_FROM_NAME=Franchise Agreement Portal
#   EMAIL_FROM_EMAIL=<same gmail address>
# Gmail limits: about 500 recipients a day for a personal account; use a business provider for volume.

# SMS for the mobile OTP. `dev_outbox` (development only) shows SMS in the test mailbox page.
SMS_PROVIDER=dev_outbox

# Private file storage. `local` (development only) keeps uploaded files in server/storage/.
# `s3` uses a PRIVATE S3-compatible bucket (block all public access).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
S3_BUCKET=
S3_REGION=ap-south-1
# Only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Networkz Systems SMS gateway (used when SMS_PROVIDER=networkz) ----------
# Create an Access Token in the Networkz panel (Manage > API Access Tokens). Paste the token and
# its key here only; never in code, chat or GitHub.
NETWORKZ_SMS_ACCESS_TOKEN=
NETWORKZ_SMS_ACCESS_TOKEN_KEY=
# From your DLT registration (not secret).
NETWORKZ_SMS_ENTITY_ID=1701158157975781029
NETWORKZ_SMS_SENDER_ID=NETSYS
NETWORKZ_SMS_ROUTE=transactional
# 1 = the gateway rejects any message that does not match a DLT template listed in its panel.
NETWORKZ_SMS_TEMPLATE_MATCHING=0
# Optional delivery-status webhook (needs a public HTTPS address for the API):
# create it in the panel with target https://<your-api>/api/webhooks/networkz-sms, method POST-JSON,
# header X-Webhook-Secret: <long random value>. Then set both values below.
NETWORKZ_SMS_WEBHOOK_ID=
NETWORKZ_SMS_WEBHOOK_SECRET=
# Per-message DLT template IDs and wording are set by Admin in the portal: Admin > SMS Notifications.
