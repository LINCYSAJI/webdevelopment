# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local development uses the private database started by `npm run db`.
# In production, use the MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/franchise_portal?replicaSet=rs0

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Address the browser uses to open the portal. Used in links inside emails.
CLIENT_ORIGIN=http://localhost:5173

# Email delivery. `dev_outbox` (development only) keeps emails in the test mailbox page.
EMAIL_PROVIDER=dev_outbox

# SMS for the mobile OTP. `dev_outbox` (development only) shows SMS in the test mailbox page.
SMS_PROVIDER=dev_outbox

# Private file storage. `local` (development only) keeps uploaded files in server/storage/.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
